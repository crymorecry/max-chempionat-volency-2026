generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApartmentRole {
  OWNER
  TENANT
}

enum RequestStatus {
  CREATED
  IN_PROGRESS
  RESOLVED
}

model User {
  id        String @id @default(uuid())
  maxUserId String @unique
  name      String
  photo     String?

  apartments   UserApartment[]
  requests     Request[]
  leasesOwned  Lease[]         @relation("LeaseOwner")
  leasesRented Lease[]         @relation("LeaseTenant")

  createdAt DateTime @default(now())
}

model Apartment {
  id      String @id @default(uuid())
  address String

  users    UserApartment[]
  leases   Lease[]
  news     News[]
  requests Request[]
  contacts Contact[]

  createdAt DateTime @default(now())
}

model UserApartment {
  id String @id @default(uuid())

  userId      String
  apartmentId String

  role     ApartmentRole
  isActive Boolean       @default(true)

  user      User      @relation(fields: [userId], references: [id])
  apartment Apartment @relation(fields: [apartmentId], references: [id])

  @@unique([userId, apartmentId, role])
}

model Lease {
  id Int @id @default(autoincrement())

  apartmentId String
  ownerId     String
  tenantId    String?

  // Например 45000
  price Int

  // До какого числа платить
  paymentDay Int

  // До какого числа передавать счётчики
  meterReadingDay Int?

  conditionsRent String?

  isActive     Boolean   @default(true)
  endDate      DateTime?
  
  maxInviteUrl String?
  apartment    Apartment @relation(fields: [apartmentId], references: [id])

  owner  User  @relation("LeaseOwner", fields: [ownerId], references: [id])
  tenant User? @relation("LeaseTenant", fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
}

model News {
  id Int @id @default(autoincrement())

  apartmentId String

  title       String
  description String
  fullContent String

  apartment Apartment @relation(fields: [apartmentId], references: [id])

  createdAt DateTime @default(now())
}

model Request {
  id Int @id @default(autoincrement())

  apartmentId String
  userId      String

  title       String
  description String?

  status RequestStatus @default(CREATED)

  apartment Apartment @relation(fields: [apartmentId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id          Int @id @default(autoincrement())
  apartmentId String

  name        String
  description String?
  phone       String?

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
